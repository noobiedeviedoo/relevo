# Copia este archivo como .env y rellénalo. Nunca subas .env al repositorio.

# Entorno en el que corre la app: local | develop | preproduccion | produccion
PUBLIC_APP_ENV=local

# URL pública de la app en este entorno (para enlaces en emails y OAuth)
PUBLIC_SITE_URL=http://localhost:4321

# Supabase (en local, los valores salen de `npm run db:start`)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: nunca se expone al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (fase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails (fase 5)
RESEND_API_KEY=
